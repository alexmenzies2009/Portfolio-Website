---
import Logo from './Logo.astro';
import { site } from '../data/site';
---

<header class="hdr">
  <a class="hdr__logo" href="/" aria-label={`${site.name} — home`}>
    <Logo class="hdr__mark" />
  </a>
  <div class="hdr__right">
    <button class="hdr__theme" type="button" data-theme-toggle aria-label="Switch to light mode">
      <span class="hdr__dial" aria-hidden="true"></span>
      <span class="mono" data-theme-label>Light</span>
    </button>
  <button class="hdr__toggle" type="button" data-menu-toggle aria-expanded="false" aria-controls="menu" aria-label="Open menu">
    <span class="mono" data-menu-label>Menu</span>
    <span class="hdr__bars" aria-hidden="true"><i></i><i></i></span>
  </button>
  </div>
</header>

<style>
  /* Blends with whatever is behind it, so it stays legible over light images. */
  .hdr {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 110;
    height: var(--header-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-inline: var(--gutter);
    color: #fff;
    mix-blend-mode: difference;
    pointer-events: none;
  }
  .hdr > * {
    pointer-events: auto;
  }
  .hdr__logo {
    display: block;
    padding-block: 0.5rem;
  }
  .hdr :global(.hdr__mark) {
    width: clamp(2.5rem, 2rem + 1.5vw, 3.5rem);
    height: auto;
    transition: transform 0.7s var(--ease-out);
  }
  .hdr__logo:hover :global(.hdr__mark) {
    transform: scale(1.08) rotate(-4deg);
  }
  .hdr__right {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 2vw, 2rem);
  }
  .hdr__theme {
    display: inline-flex;
    align-items: center;
    gap: 0.75em;
    padding: 0.9rem 0;
  }
  /* half-filled dial that flips when the theme changes */
  .hdr__dial {
    width: 15px;
    height: 15px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1.5px currentColor;
    background: linear-gradient(90deg, currentColor 50%, transparent 50%);
    transition: rotate 0.7s var(--ease-out);
  }
  .hdr__theme:hover .hdr__dial {
    rotate: 45deg;
  }
  :global(html[data-theme='light']) .hdr__dial {
    rotate: 180deg;
  }
  :global(html[data-theme='light']) .hdr__theme:hover .hdr__dial {
    rotate: 225deg;
  }
  @media (max-width: 480px) {
    .hdr__theme .mono {
      display: none;
    }
  }
  .hdr__toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.95em;
    padding: 0.9rem 0 0.9rem 1rem;
  }
  .hdr__bars {
    display: grid;
    gap: 6px;
    width: 28px;
  }
  .hdr__bars i {
    height: 1.5px;
    background: currentColor;
    transform-origin: center;
    transition: transform 0.6s var(--ease-out);
  }
  .hdr__toggle:hover .hdr__bars i:last-child {
    transform: scaleX(0.55);
    transform-origin: right;
  }
  :global(html.menu-open) .hdr__bars i:first-child {
    transform: translateY(3.75px) rotate(45deg);
  }
  :global(html.menu-open) .hdr__bars i:last-child,
  :global(html.menu-open) .hdr__toggle:hover .hdr__bars i:last-child {
    transform: translateY(-3.75px) rotate(-45deg);
    transform-origin: center;
  }
</style>
