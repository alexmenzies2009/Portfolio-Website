---
import { Image, getImage } from 'astro:assets';
import Arrow from './Arrow.astro';
import { getWork } from '../lib/work';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Services from '../components/Services.astro';
import ContactCta from '../components/ContactCta.astro';
import Pill from '../components/Pill.astro';
import { site, about } from '../data/site';

interface Props {
  /** The hero shows a portrait built from project thumbnails; hovering it lifts tiles out (/backup). */
  mosaic?: boolean;
  /** The portrait, with projects stepping out of it as cards instead of the hover lens (/, src/scripts/emerge.ts). */
  emerge?: boolean;
  /** Test (/test): the projects under the hero stand on a turning 3D ring instead of the moving strip. */
  ring?: boolean;
  /** Test v2 (/testv2): a line runs down the whole page from the hero, pausing at each section (src/scripts/thread.ts). */
  thread?: boolean;
  /** Page title; leave out for the site's default title. */
  title?: string;
  /** Hide the page from search engines (the kept-for-reference versions). */
  noindex?: boolean;
}
const { mosaic: mosaicProp = false, emerge = false, ring = false, thread = false, title, noindex = false } = Astro.props;
const mosaic = mosaicProp || emerge;
const work = await getWork();
const featured = work.filter((p) => p.data.featured);
// what the preview card shows when a thumbnail in the portrait is clicked
const peek = mosaic
  ? Object.fromEntries(
      await Promise.all(
        work.map(async (p) => [
          p.id,
          {
            title: p.data.title,
            meta: `${String(p.data.number).padStart(2, '0')} — ${p.data.category}`,
            text: p.data.tagline,
            tools: p.data.tools.join(' · '),
            accent: p.data.accent ?? '',
            cover: (await getImage({ src: p.data.cover, width: 800, format: 'webp', quality: 76 })).src,
            thumb: emerge ? (await getImage({ src: p.data.cover, width: 400, height: 400, fit: 'cover', format: 'webp', quality: 74 })).src : '',
          },
        ]),
      ),
    )
  : null;

// Projects shown in the moving strip under the hero (file names from src/content/work).
const stripSlugs = ['astroflame', 'blue2purple', 'the-joker', 'beat-invasion', 'f1', 'hairspace', 'ai', 'the-batman', 'spacecat', 'back-to-school', 'neon-rider', 'noval'];
const strip = stripSlugs.map((slug) => work.find((p) => p.id === slug)).filter((p) => p !== undefined);
// the ring in the Work section (test): the featured projects first, topped up from the strip to ten
const ringProjects = [...featured, ...strip.filter((p) => !featured.includes(p))].slice(0, 10);

const letters = site.role.toUpperCase().split('');
const pad = (n: number) => String(n).padStart(2, '0');
const year = new Date().getFullYear();
---

<Base title={title} noindex={noindex} htmlClass={thread ? 'has-thread' : undefined}>
  <section
    class:list={['hero', mosaic && 'hero--mosaic', emerge && 'hero--color']}
    data-wordmark-zone
    data-rotate-scope={emerge ? '' : undefined}
    style={emerge ? `--rotate-color:${site.disciplineAccents[0]}` : undefined}
  >
    <h1 class="sr-only">{site.name} — graphic designer based in Brussels</h1>
    {
      mosaic ? (
        <>
          <canvas class="mosaic" data-mosaic data-map="/mosaic/map.json" data-atlas="/mosaic/atlas.webp" aria-hidden="true" />
          {emerge ? <div class="emerge" data-emerge /> : <div class="mosaic-tip mono" data-mosaic-tip aria-hidden="true" />}
          <div class="peek" data-peek role="dialog" aria-label="Project preview" hidden>
            <div class="peek__img frame" data-peek-frame>
              <img data-peek-img alt="" />
            </div>
            <div class="peek__body">
              <p class="mono dim" data-peek-meta />
              <h2 class="peek__title" data-peek-title />
              <p class="peek__text" data-peek-text />
              <p class="mono dim" data-peek-tools />
              <div class="peek__actions">
                <a class="pill" href="/work/" data-peek-link data-project-link>
                  <span class="pill__label">
                    <span>Open project</span>
                    <span aria-hidden="true">Open project</span>
                  </span>
                  <Arrow class="pill__arrow" />
                </a>
                <button class="bracket" type="button" data-peek-close>
                  Close
                </button>
              </div>
            </div>
          </div>
          <script type="application/json" data-peek-data set:html={JSON.stringify(peek)} />
        </>
      ) : (
        <>
          <canvas class="field" data-field aria-hidden="true" />
          <div class="hero__trail" data-trail aria-hidden="true">
            {strip.slice(0, 8).map((p) => <Image src={p.data.cover} alt="" width={420} height={520} quality={70} loading="eager" />)}
          </div>
        </>
      )
    }

    <div class="hero__top wrap">
      {
        site.available && (
          <p class="hero__avail mono" data-reveal data-delay="0.75">
            <span class="pulse" aria-hidden="true" />
            Available for work
          </p>
        )
      }
      {!ring && <p class="hero__intro" data-split data-delay="0.55">Graphic designer based in Brussels — web design, illustration &amp; visuals.</p>}
    </div>

    <div class="hero__word wrap">
      <p class="hero__kicker mono" aria-hidden="true" data-reveal data-delay="0.85">
        [<span class="hero__rot"><span data-rotate={JSON.stringify(site.disciplines)} data-rotate-colors={emerge ? JSON.stringify(site.disciplineAccents) : undefined}>{site.disciplines[0]}</span></span>]
      </p>
      <p class="wordmark" data-wordmark aria-hidden="true">
        {letters.map((ch) => <span class="wm__l"><span class="wm__i">{ch}</span></span>)}
      </p>
    </div>

    <div class="hero__base wrap mono" data-reveal data-delay="0.95">
      <span>{site.name} — Portfolio ©{year}</span>
      <span class="hero__where">{site.locationShort} — <span data-clock="short">--:--</span></span>
      <span>Scroll ↓</span>
    </div>
  </section>

  {
    ring ? null : (
  <section class="strip" data-marquee data-marquee-pause data-speed="0.55" aria-label="A few projects">
    <ul class="strip__track" data-marquee-track>
      {
        strip.map((p, i) => (
          <li class="strip__item">
            <a class="strip__link" href={`/work/${p.id}/`} data-project-link data-accent={p.data.accent ?? ''} data-cursor="View">
              <div class="strip__frame" data-cover={p.id} style={`aspect-ratio:${Math.min(1.45, Math.max(0.78, p.data.cover.width / p.data.cover.height)).toFixed(3)}`}>
                <Image src={p.data.cover} alt="" widths={[420, 760, 1100]} sizes="(min-width: 900px) 30vw, 62vw" quality={74} loading={i < 4 ? 'eager' : 'lazy'} />
              </div>
              <span class="strip__cap mono">
                <span class="dim">{pad(p.data.number)}</span>
                <span>{p.data.title}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
    )
  }

  <section class:list={['about wrap section grid', ring && 'about--roomy']} data-rail="01">
    <p class="eyebrow mono about__eyebrow" data-reveal style="--tint: var(--c-cyan)">
      <span class="eyebrow__num">01</span>
      <span class="eyebrow__rule"></span>
      <span>About</span>
    </p>
    <div class="about__body">
      <p class="about__text" data-scrub-words>{site.intro}</p>
      <div class="about__row" data-reveal>
        <Pill href="/about/" label="More about me" />
        <a class="about__face frame" href="/about/" tabindex="-1" aria-hidden="true">
          <Image src={about.portrait} alt="" width={240} height={240} quality={76} loading="lazy" />
        </a>
      </div>
    </div>
  </section>

  <Services>
    <div class="svc-more" data-reveal>
      <Pill href="/stack/" label="Tools I use" ghost />
    </div>
  </Services>

  <section class="work wrap section" data-rail="02">
    <header class="work__head grid">
      <p class="eyebrow mono work__eyebrow" data-reveal style="--tint: var(--c-violet)">
        <span class="eyebrow__num">02</span>
        <span class="eyebrow__rule"></span>
        <span>Work</span>
      </p>
      <h2 class="work__title display" data-split="chars">Selected work</h2>
      <div class="work__side">
        <p class="work__intro pretty" data-split>{site.workIntro}</p>
        <div data-reveal>
          <Pill href="/work/" label={`See all ${work.length} projects`} />
        </div>
      </div>
    </header>
    {
      ring ? (
        <div class="ring" data-ring data-cursor="Drag">
          <div class="ring__stage">
            <ul class="ring__wheel" data-ring-wheel>
              {ringProjects.map((p, i) => (
                <li class="ring__item" style={`--i:${i}`} data-ring-item>
                  <ProjectCard entry={p} large ratio="4 / 3" sizes="(min-width: 900px) 30vw, 70vw" eager={i < 4} />
                </li>
              ))}
            </ul>
          </div>
          <p class="ring__hint mono dim">Drag to spin ↔</p>
        </div>
      ) : (
        <div class="work__pin" data-hscroll>
          <div class="work__track" data-hscroll-track>
            {featured.map((p) => <ProjectCard entry={p} large class="work__card" ratio="4 / 3" sizes="(min-width: 900px) 48vw, 100vw" />)}
            <a class="work__all" href="/work/" data-cursor="All">
              <span class="mono dim">{work.length} projects</span>
              <span class="work__all-title display">See all work</span>
            </a>
          </div>
        </div>
      )
    }
  </section>

  <ContactCta index="03" />

  <div class="rail mono" aria-hidden="true" data-rail-ui>
    <span data-rail-now>01</span>
    <span class="rail__line"><i data-rail-fill></i></span>
    <span>03</span>
  </div>
</Base>

<script>
  import { gsap, reduced, finePointer } from '../scripts/motion';
  import { initMosaic } from '../scripts/mosaic';
  import { initEmerge } from '../scripts/emerge';
  import { initRing } from '../scripts/ring';
  import { initThread } from '../scripts/thread';

  initRing();
  initThread();

  const emergeLayer = document.querySelector('[data-emerge]');
  const peekInfo = JSON.parse(document.querySelector('[data-peek-data]')?.textContent || '{}');
  initMosaic({ hover: !emergeLayer }).then((m) => m && emergeLayer && initEmerge(m, peekInfo));

  // clicking a thumbnail in the portrait opens a short preview of that project
  const peek = document.querySelector<HTMLElement>('[data-peek]');
  const peekData = document.querySelector('[data-peek-data]');
  if (peek && peekData) {
    type Info = { title: string; meta: string; text: string; tools: string; accent: string; cover: string };
    const info: Record<string, Info> = peekInfo;
    const zone = peek.parentElement as HTMLElement;
    const root = document.documentElement;
    const part = <T extends HTMLElement>(name: string) => peek.querySelector<T>(`[data-peek-${name}]`)!;
    const close = () => {
      if (peek.hidden) return;
      peek.hidden = true;
      root.style.removeProperty('--accent');
      root.style.removeProperty('--on-accent');
      root.classList.remove('has-glow');
    };
    zone.addEventListener('mosaic:pick', (e) => {
      const { slug, x, y, pad = 40 } = (e as CustomEvent<{ slug: string; x: number; y: number; pad?: number }>).detail;
      const project = info[slug];
      if (!project) return;
      part<HTMLImageElement>('img').src = project.cover;
      part('frame').dataset.cover = slug;
      part('meta').textContent = project.meta;
      part('title').textContent = project.title;
      part('text').textContent = project.text;
      part('tools').textContent = project.tools;
      part<HTMLAnchorElement>('link').href = `/work/${slug}/`;
      peek.dataset.accent = project.accent;
      peek.hidden = false;
      // beside the click, kept inside the hero
      const w = peek.offsetWidth, h = peek.offsetHeight;
      const left = x + pad + w > zone.clientWidth - 16 ? x - pad - w : x + pad;
      const top = Math.min(Math.max(y - h / 2, 80), Math.max(80, zone.clientHeight - h - 16));
      gsap.set(peek, { x: Math.max(16, left), y: top });
      if (project.accent) {
        root.style.setProperty('--accent', project.accent);
        root.style.setProperty('--on-accent', '#09090a');
        root.classList.add('has-glow');
      }
      if (!reduced) gsap.fromTo(peek, { opacity: 0, scale: 0.94 }, { opacity: 1, scale: 1, duration: 0.45, ease: 'expo.out' });
      part<HTMLAnchorElement>('link').focus({ preventScroll: true });
    });
    part('close').addEventListener('click', close);
    addEventListener('keydown', (e) => e.key === 'Escape' && close());
    document.addEventListener('pointerdown', (e) => {
      if (!(e.target instanceof Element) || !e.target.closest('[data-peek]')) close();
    });
    addEventListener('scroll', () => scrollY > innerHeight * 0.5 && close(), { passive: true });
  }

  // moving the pointer across the hero leaves a trail of work behind it
  const trail = document.querySelector<HTMLElement>('[data-trail]');
  const hero = trail?.parentElement;
  if (trail && hero && finePointer && !reduced) {
    const shots = [...trail.querySelectorAll<HTMLElement>('img')];
    let next = 0;
    let last = { x: -999, y: -999 };
    let z = 1;
    hero.addEventListener('pointermove', (e) => {
      if (Math.hypot(e.clientX - last.x, e.clientY - last.y) < 130) return;
      last = { x: e.clientX, y: e.clientY };
      const box = hero.getBoundingClientRect();
      const img = shots[next++ % shots.length];
      gsap.killTweensOf(img);
      gsap.set(img, { x: e.clientX - box.left, y: e.clientY - box.top, xPercent: -50, yPercent: -50, zIndex: z++, rotate: gsap.utils.random(-9, 9) });
      gsap.fromTo(img, { autoAlpha: 1, scale: 0.55 }, { scale: 1, duration: 0.7, ease: 'expo.out' });
      gsap.to(img, { autoAlpha: 0, scale: 0.85, duration: 0.5, ease: 'power2.in', delay: 0.75 });
    });
  }

  // Selected work: vertical scrolling drives the row sideways while it stays pinned
  const pin = document.querySelector<HTMLElement>('[data-hscroll]');
  const track = pin?.querySelector<HTMLElement>('[data-hscroll-track]');
  if (pin && track) {
    gsap.matchMedia().add('(min-width: 901px) and (prefers-reduced-motion: no-preference)', () => {
      const distance = () => Math.max(0, track.scrollWidth - pin.clientWidth);
      gsap.to(track, {
        x: () => -distance(),
        ease: 'none',
        scrollTrigger: { trigger: pin, start: 'center center', end: () => `+=${distance()}`, pin: true, scrub: 0.6, invalidateOnRefresh: true, anticipatePin: 1, refreshPriority: 1 },
      });
    });
  }

  // the small "01 — 03" progress rail on the right edge
  const rail = document.querySelector<HTMLElement>('[data-rail-ui]');
  if (rail) {
    const fill = rail.querySelector('[data-rail-fill]');
    const now = rail.querySelector('[data-rail-now]');
    const sections = [...document.querySelectorAll<HTMLElement>('[data-rail]')];
    const sync = () => {
      let current = sections[0]?.dataset.rail || '01';
      for (const section of sections) if (section.getBoundingClientRect().top < innerHeight * 0.55) current = section.dataset.rail || current;
      if (now && now.textContent !== current) now.textContent = current;
    };
    gsap.fromTo(fill, { scaleY: 0 }, { scaleY: 1, ease: 'none', scrollTrigger: { start: 0, end: 'max', scrub: 0.3, onUpdate: sync, onRefresh: sync } });
  }
</script>

<style>
  /* ---------- hero ---------- */
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-rows: auto 1fr auto;
    min-height: 86svh;
    padding-top: calc(var(--header-h) + clamp(0.5rem, 2vh, 2rem));
  }
  .hero > :not(.hero__trail):not(canvas):not(.mosaic-tip):not(.emerge):not(.peek):not(script) {
    position: relative;
    z-index: 1;
  }
  /* test version: the portrait canvas fills the hero and the page is a full screen tall */
  .hero--mosaic {
    min-height: 100svh;
  }
  .mosaic {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  /* the short preview that opens when a thumbnail is clicked */
  .peek {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 4;
    width: min(21rem, calc(100vw - 2 * var(--gutter)));
    padding: 0.6rem;
    border-radius: calc(var(--radius) * 1.2);
    background: var(--surface);
    box-shadow:
      inset 0 0 0 1px var(--line-2),
      0 30px 80px rgb(0 0 0 / 0.45);
    cursor: default;
  }
  .peek__img {
    aspect-ratio: 4 / 3;
    border-radius: calc(var(--radius) * 0.8);
  }
  .peek__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .peek__body {
    display: grid;
    gap: 0.55rem;
    padding: 0.9rem 0.5rem 0.5rem;
  }
  .peek__title {
    font-size: 1.7rem;
    font-weight: 650;
    line-height: 1.05;
    letter-spacing: -0.035em;
  }
  .peek__text {
    color: var(--fg-2);
    font-size: 0.98rem;
    line-height: 1.35;
  }
  .peek__actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 0.5rem;
  }
  .peek__actions .pill {
    padding: 0.85em 1.2em 0.85em 1.3em;
    font-size: 0.95rem;
  }

  /* the label that follows the cursor over the portrait */
  .mosaic-tip {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 3;
    padding: 0.6em 0.9em;
    border-radius: 999px;
    background: var(--fg);
    color: var(--ink);
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.25s;
  }
  .mosaic-tip.is-on {
    opacity: 1;
  }
  /* V2: the rotating word, its brackets and the "available" dot take a project colour */
  .hero--color .hero__kicker {
    color: color-mix(in srgb, var(--rotate-color) 55%, var(--fg-2));
    transition: color 0.6s var(--ease-out, ease);
  }
  .hero--color .hero__rot {
    color: var(--rotate-color);
    transition: color 0.6s var(--ease-out, ease);
  }
  .hero--color .hero__avail :global(.pulse),
  .hero--color .hero__avail :global(.pulse::after) {
    background: var(--rotate-color);
    transition: background-color 0.6s var(--ease-out, ease);
  }
  /* V2: the project cards that step out of the portrait (built by src/scripts/emerge.ts) */
  .emerge {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
  }
  .emerge :global(.emerge__card) {
    position: absolute;
    top: 0;
    left: 0;
    display: grid;
    gap: 0.55rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--fg);
    text-align: left;
    pointer-events: auto;
    cursor: pointer;
    will-change: transform;
  }
  .emerge :global(.emerge__img) {
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: calc(var(--radius) * 0.7);
    box-shadow: 0 24px 60px rgb(0 0 0 / 0.5);
  }
  .emerge :global(.emerge__img img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: scale 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .emerge :global(.emerge__card:hover .emerge__img img),
  .emerge :global(.emerge__card:focus-visible .emerge__img img) {
    scale: 1.07;
  }
  .emerge :global(.emerge__card:focus-visible) {
    outline: none;
  }
  .emerge :global(.emerge__card:focus-visible .emerge__img) {
    outline: 1px solid var(--fg);
    outline-offset: 4px;
  }
  .emerge :global(.emerge__cap) {
    display: flex;
    gap: 0.6em;
    overflow: hidden;
    font-size: 0.68rem;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .emerge :global(.emerge__cap > span:last-child) {
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .hero__trail {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    overflow: clip;
  }
  .hero__trail :global(img) {
    position: absolute;
    top: 0;
    left: 0;
    width: clamp(9rem, 15vw, 15rem);
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius);
    opacity: 0;
    visibility: hidden;
    transition: none;
  }
  .hero__top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 2rem;
  }
  .hero__avail {
    display: inline-flex;
    align-items: center;
    gap: 1em;
    padding-top: 0.35em;
  }
  .hero__intro {
    max-width: 23ch;
    font-size: clamp(1.15rem, 0.9rem + 0.95vw, 1.75rem);
    font-weight: 500;
    line-height: 1.16;
    letter-spacing: -0.022em;
    text-align: right;
  }
  .hero__word {
    align-self: end;
    display: grid;
    gap: clamp(0.5rem, 1.2vw, 1.25rem);
  }
  .hero__kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.55em;
    color: var(--fg-2);
    font-size: clamp(1rem, 0.55rem + 1.25vw, 1.75rem);
    font-weight: 500;
    letter-spacing: 0.02em;
  }
  .hero__rot {
    display: inline-block;
    overflow: clip;
    color: var(--fg);
  }
  .hero__rot > span {
    display: inline-block;
  }
  .wordmark {
    display: flex;
    justify-content: space-between;
    font-size: 17.4vw;
    font-weight: 800;
    line-height: 0.8;
    text-transform: uppercase;
    user-select: none;
  }
  .wm__l {
    display: block;
    overflow-x: visible;
    overflow-y: clip;
    padding-block: 0.03em;
  }
  .wm__i {
    display: block;
    will-change: transform;
  }
  .hero__base {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: clamp(0.9rem, 1.8vw, 1.6rem);
    color: var(--fg-2);
    font-variant-numeric: tabular-nums;
  }

  .about--roomy {
    padding-top: calc(var(--section) + clamp(2rem, 5vw, 5rem));
  }

  /* ---------- project ring (test): the Work section's cards on a turning 3D ring ---------- */
  .ring {
    --w: clamp(18rem, 9rem + 26vw, 33rem);
    position: relative;
    display: grid;
    gap: clamp(1rem, 2vw, 1.75rem);
    /* pulled up toward the "Selected work" title */
    margin: calc(-1 * clamp(1rem, 3vw, 3rem)) calc(-1 * var(--gutter)) 0;
    overflow: clip;
    touch-action: pan-y;
    user-select: none;
  }
  /* without the script (or with reduced motion): a row that scrolls sideways */
  .ring__wheel {
    display: flex;
