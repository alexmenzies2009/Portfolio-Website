---
// The AM mark, inline so it can take any colour (it uses currentColor).
import raw from '../assets/brand/logo.svg?raw';
interface Props {
  class?: string;
}
const { class: cls = '' } = Astro.props;
const svg = raw.replace('<svg ', `<svg class="${cls}" aria-hidden="true" focusable="false" `);
---

<Fragment set:html={svg} />
