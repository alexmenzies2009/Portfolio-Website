---
import { Image } from 'astro:assets';
import { getWork } from '../lib/work';
import { nav, socials, site, about, services, playground } from '../data/site';

const work = await getWork();
// the picture each link shows while hovered, in nav order
const previews = [work[0].data.cover, about.portrait, playground[0].image, services[2].image, services[1].image];
const here = Astro.url.pathname.replace(/\/$/, '');
const pad = (n: number) => String(n).padStart(2, '0');
---

<div class="menu" id="menu" role="dialog" aria-modal="true" aria-label="Menu" hidden>
  <nav class="menu__nav wrap" aria-label="Main">
    <ul>
      {
        nav.map((item, i) => (
          <li>
            <a class="menu__link" href={item.href} data-menu-link={i} aria-current={here.startsWith(item.href.replace(/\/$/, '')) ? 'page' : undefined}>
              <span class="menu__clip">
                <span class="menu__text display" data-menu-item>
                  {item.label}
                </span>
              </span>
              <span class="menu__num mono" data-menu-fade>
                {pad(i + 1)}
                {item.label === 'Work' && ` / ${work.length} projects`}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="menu__preview" data-menu-preview aria-hidden="true">
    {previews.map((img, i) => <Image src={img} alt="" width={720} quality={72} loading="lazy" class="menu__img" data-i={i} />)}
  </div>

  <div class="menu__foot mono">
    <ul class="menu__socials">
      {
        socials.map((s) => (
          <li data-menu-fade>
            <a class="ulink" href={s.href} target="_blank" rel="noopener">
              {s.label} ↗
            </a>
          </li>
        ))
      }
    </ul>
    <p class="menu__where" data-menu-fade>
      {site.locationShort} — <span data-clock>--:--:--</span>
      <span data-clock-zone></span>
    </p>
  </div>
</div>

<style>
  .menu {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    grid-template-rows: 1fr auto;
    padding-top: var(--header-h);
    background: var(--bg);
    overflow: clip;
  }
  .menu::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(70vw 70vh at 92% 4%, color-mix(in oklab, var(--accent) 13%, transparent), transparent 70%);
  }
  .menu__nav {
    position: relative;
    z-index: 1;
    align-self: center;
  }
  .menu__nav ul {
    display: grid;
    justify-items: start;
  }
  .menu__link {
    display: flex;
    align-items: baseline;
    gap: clamp(0.6rem, 1.4vw, 1.5rem);
  }
  .menu__clip {
    display: block;
    overflow: clip;
    padding-block: 0.05em 0.1em;
    margin-block: -0.05em -0.1em;
  }
  .menu__text {
    display: block;
    font-size: min(11.4vw, 15.4vh);
    transition:
      font-stretch 0.75s var(--ease-out),
      opacity 0.4s;
  }
  .menu__num {
    color: var(--fg-3);
    white-space: nowrap;
  }
  .menu__link[aria-current] .menu__num::after {
    content: ' — you are here';
    color: var(--fg);
  }
  .menu__link:focus-visible .menu__text {
    --wdth: 125;
  }
  @media (hover: hover) {
    .menu__link:hover .menu__text {
      --wdth: 125;
    }
    .menu__nav ul:has(.menu__link:hover) .menu__link:not(:hover) .menu__text {
      --wdth: 80;
      opacity: 0.28;
    }
  }

  .menu__preview {
    position: absolute;
    right: calc(var(--gutter) + 2vw);
    top: 50%;
    width: min(25vw, 42vh);
    aspect-ratio: 4 / 5;
    overflow: clip;
    border-radius: var(--radius);
    transform: translateY(-50%) rotate(3.5deg);
    pointer-events: none;
  }
  .menu__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transform: scale(1.14);
    transition:
      opacity 0.5s var(--ease-out),
      transform 1.1s var(--ease-out);
  }
  .menu__preview[data-active='0'] [data-i='0'],
  .menu__preview[data-active='1'] [data-i='1'],
  .menu__preview[data-active='2'] [data-i='2'],
  .menu__preview[data-active='3'] [data-i='3'],
  .menu__preview[data-active='4'] [data-i='4'] {
    opacity: 1;
    transform: none;
  }

  .menu__foot {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.9rem 2rem;
    margin-inline: var(--gutter);
    padding-block: clamp(1rem, 2.6vh, 1.75rem);
    border-top: 1px solid var(--line);
  }
  .menu__socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem clamp(1rem, 2.4vw, 2.25rem);
  }
  .menu__where {
    color: var(--fg-2);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 860px) {
    .menu__preview {
      display: none;
    }
    .menu__text {
      font-size: min(13vw, 12.5vh);
    }
    .menu__link {
      flex-direction: column;
      gap: 0.2rem;
      padding-block: 0.35rem;
    }
  }
</style>
