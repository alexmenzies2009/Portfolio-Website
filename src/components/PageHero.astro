---
// Opening block for the inner pages: each line of the title is sized to span the full width.
interface Props {
  eyebrow: string;
  /** One entry per line of the title. */
  lines: string[];
  /** Small number shown next to the title, e.g. the project count. */
  count?: number | string;
  /** Tallest a line may get, in % of the viewport height. */
  max?: number;
}
const { eyebrow, lines, count, max = 34 } = Astro.props;
---

<section class="phero wrap">
  <canvas class="field" data-field aria-hidden="true"></canvas>
  <p class="eyebrow mono" data-reveal data-delay="0.55">
    <span class="eyebrow__rule"></span>
    <span>{eyebrow}</span>
    {count !== undefined && <span class="phero__count">({count})</span>}
  </p>
  <h1 class="phero__title display">
    {
      lines.map((line, i) => (
        <span class="phero__line" data-fit data-fit-max={max}>
          <span data-fit-text data-split="chars" data-delay={0.22 + i * 0.12}>
            {line}
          </span>
        </span>
      ))
    }
  </h1>
  <slot />
</section>

<style>
  .phero {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(1.1rem, 2.4vw, 2.25rem);
    padding-top: calc(var(--header-h) + clamp(2rem, 8vh, 6rem));
  }
  .phero__count {
    color: var(--fg);
  }
  .phero__title {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.03em;
    font-size: var(--fs-display);
  }
  .phero__line {
    display: block;
    line-height: 0.84;
    white-space: nowrap;
  }
  .phero__line > span {
    display: inline-block;
  }
</style>
