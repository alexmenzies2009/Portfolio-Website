---
// A project tile. Hovering it lends the whole page the project's accent colour.
import { Image } from 'astro:assets';
import type { Project } from '../lib/work';

interface Props {
  entry: Project;
  /** CSS sizes attribute: how wide the image is shown, so the browser picks the right file. */
  sizes?: string;
  /** Aspect ratio of the image frame, e.g. "4 / 5". */
  ratio?: string;
  large?: boolean;
  parallax?: boolean;
  eager?: boolean;
  class?: string;
}
const { entry, sizes = '(min-width: 1100px) 33vw, (min-width: 640px) 50vw, 100vw', ratio, large = false, parallax = false, eager = false, class: cls } = Astro.props;
const { title, category, tools, cover, accent, number, tags } = entry.data;
const pad = (n: number) => String(n).padStart(2, '0');
---

<a
  class:list={['card', large && 'card--lg', cls]}
  href={`/work/${entry.id}/`}
  data-project-link
  data-accent={accent ?? ''}
  data-cursor="View"
  data-tags={tags.join('|')}
  style={accent ? `--card-accent:${accent};--card-on:#09090a` : undefined}
>
  <div class="card__frame" data-tilt>
    <div class="card__media" data-cover={entry.id} data-reveal="clip" style={ratio ? `--ar:${ratio}` : undefined}>
      <div class="card__zoom">
        <Image
          src={cover}
          alt=""
          widths={[480, 800, 1200, 1600, 2000]}
          sizes={sizes}
          quality={76}
          loading={eager ? 'eager' : 'lazy'}
          class="card__img"
          data-parallax={parallax ? '0.06' : undefined}
        />
      </div>
      <span class="chip card__tag">{category}</span>
    </div>
    <span class="card__marks" aria-hidden="true"></span>
  </div>
  <div class="card__meta">
    <span class="mono card__num">{pad(number)}</span>
    <h3 class="card__title">{title}</h3>
    <span class="mono card__cat">{category}</span>
    <span class="mono card__tools">{tools.slice(0, 2).join(' · ')}</span>
  </div>
</a>

<style>
  .card {
    display: grid;
    align-content: start;
    gap: clamp(0.8rem, 0.5rem + 0.8vw, 1.2rem);
  }
  .card__frame {
    position: relative;
  }
  .card__media {
    position: relative;
    overflow: clip;
    border-radius: var(--radius);
    background: var(--surface);
    aspect-ratio: var(--ar, 4 / 5);
  }
  .card__zoom {
    width: 100%;
    height: 100%;
    transition: transform 1.4s var(--ease-out);
  }
  .card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .card:hover .card__zoom,
  .card:focus-visible .card__zoom {
    transform: scale(1.045);
  }
  .card__tag {
    position: absolute;
    top: clamp(0.6rem, 1vw, 1rem);
    left: clamp(0.6rem, 1vw, 1rem);
    background: rgb(9 9 10 / 0.5);
    border-color: rgb(255 255 255 / 0.18);
    color: #fff;
    -webkit-backdrop-filter: blur(12px) saturate(1.4);
    backdrop-filter: blur(12px) saturate(1.4);
    transition:
      background-color 0.4s var(--ease-out),
      color 0.4s var(--ease-out),
      border-color 0.4s;
  }
  .card:hover .card__tag,
  .card:focus-visible .card__tag {
    background: var(--card-accent, var(--fg));
    border-color: transparent;
    color: var(--card-on, var(--ink));
  }
  /* print-style crop marks that snap around the image on hover */
  .card__marks {
    --m: 13px;
    --c: var(--card-accent, var(--fg));
    position: absolute;
    inset: -10px;
    pointer-events: none;
    opacity: 0;
    transform: scale(1.025);
    transition:
      opacity 0.35s,
      transform 0.6s var(--ease-out);
    background:
      linear-gradient(var(--c), var(--c)) top left / var(--m) 1px no-repeat,
      linear-gradient(var(--c), var(--c)) top left / 1px var(--m) no-repeat,
      linear-gradient(var(--c), var(--c)) top right / var(--m) 1px no-repeat,
      linear-gradient(var(--c), var(--c)) top right / 1px var(--m) no-repeat,
      linear-gradient(var(--c), var(--c)) bottom left / var(--m) 1px no-repeat,
      linear-gradient(var(--c), var(--c)) bottom left / 1px var(--m) no-repeat,
      linear-gradient(var(--c), var(--c)) bottom right / var(--m) 1px no-repeat,
      linear-gradient(var(--c), var(--c)) bottom right / 1px var(--m) no-repeat;
  }
  .card:hover .card__marks,
  .card:focus-visible .card__marks {
    opacity: 1;
    transform: none;
  }
  .card__meta {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 0.85rem;
    padding-inline: 0.1rem;
  }
  .card__cat {
    display: none;
  }
  .card__num,
  .card__cat,
  .card__tools {
    color: var(--fg-3);
    transition: color 0.4s;
  }
  .card:hover .card__num {
    color: var(--card-accent, var(--fg));
  }
  .card__title {
    font-size: clamp(1.2rem, 1rem + 0.75vw, 1.75rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.028em;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .card--lg .card__title {
    font-size: clamp(1.5rem, 1rem + 2vw, 3rem);
    font-weight: 650;
    letter-spacing: -0.035em;
  }
  @media (max-width: 480px) {
    .card__tools {
      display: none;
    }
    .card__meta {
      grid-template-columns: auto minmax(0, 1fr);
    }
  }
</style>
