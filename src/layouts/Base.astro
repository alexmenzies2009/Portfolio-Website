---
import '@fontsource-variable/mona-sans/wdth.css';
import '@fontsource-variable/martian-mono/wdth.css';
import '../styles/global.css';
import sansUrl from '@fontsource-variable/mona-sans/files/mona-sans-latin-wdth-normal.woff2?url';
import monoUrl from '@fontsource-variable/martian-mono/files/martian-mono-latin-wdth-normal.woff2?url';
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Menu from '../components/Menu.astro';
import Footer from '../components/Footer.astro';
import Logo from '../components/Logo.astro';
import { site, socials } from '../data/site';

interface Props {
  /** Page name; the site name is appended automatically. */
  title?: string;
  description?: string;
  /** Social-share image; defaults to the logo card. */
  image?: ImageMetadata;
  /** Fixed accent colour for this page (project pages). */
  accent?: string;
  /** Keep this page out of search engines. */
  noindex?: boolean;
}
const { title, description = site.description, image, accent, noindex = false } = Astro.props;

const fullTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.role} · Portfolio`;
const abs = (path: string) => (Astro.site ? new URL(path, Astro.site).href : path);
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: 'Graphic designer',
  description: site.description,
  address: { '@type': 'PostalAddress', addressLocality: 'Brussels', addressCountry: 'BE' },
  sameAs: socials.map((s) => s.href),
  ...(Astro.site ? { url: Astro.site.href } : {}),
};
const share = image ? (await getImage({ src: image, width: 1200, height: 630, fit: 'cover', format: 'jpg', quality: 82 })).src : '/og.jpg';
---

<!doctype html>
<html lang="en" style={accent ? `--accent:${accent};--on-accent:#09090a` : undefined} data-accent-base={accent} data-glow={accent ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#09090a" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="color-scheme" content="dark" />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={sansUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={monoUrl} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={abs(share)} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />

    <!-- wait for the whole (small) document before the first paint so page transitions can find their targets -->
    <link rel="expect" href="#page-end" blocking="render" />
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        // the intro plays on the first page of a visit (not for visitors who prefer reduced motion)
        // saved light/dark choice, applied before the first paint
        try {
          if (localStorage.getItem('theme') === 'light') d.dataset.theme = 'light';
        } catch (err) {}
        // The intro plays whenever someone arrives at the site or reloads a page,
        // but not when moving between pages inside it.
        try {
          var nav = performance.getEntriesByType('navigation')[0];
          var type = nav ? nav.type : 'navigate';
          var internal = document.referrer.indexOf(location.origin) === 0;
          var arriving = type === 'reload' || (type === 'navigate' && !internal);
          if (arriving && !matchMedia('(prefers-reduced-motion: reduce)').matches) d.classList.add('is-loading');
        } catch (err) {}
        // never leave content hidden if the main script fails to load
        setTimeout(function () {
          d.classList.add('is-ready');
        }, 4000);
        setTimeout(function () {
          d.classList.remove('is-loading');
        }, 9000);

        // Shared-element page transition: a project's cover morphs between its card and its page.
        document.addEventListener(
          'click',
          function (e) {
            var a = e.target && e.target.closest ? e.target.closest('a[data-project-link]') : null;
            if (!a || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
            var media = a.querySelector('[data-cover]');
            if (!media || media.offsetWidth < 24) return;
            document.querySelectorAll('.vt-cover').forEach(function (n) {
              n.classList.remove('vt-cover');
            });
            media.classList.add('vt-cover');
          },
          true,
        );
        addEventListener('pageswap', function () {
          try {
            sessionStorage.setItem('vt:from', location.pathname);
          } catch (err) {}
        });
        // The element a cover lands on must be fully visible in the new page's first frame (that is
        // what the transition captures): skip its reveal animation and show its image at once.
        var settle = function (el) {
          el.dataset.revealDone = '1';
          el.querySelectorAll('img').forEach(function (img) {
            img.loading = 'eager';
            img.classList.add('is-loaded');
          });
        };
        addEventListener('pagereveal', function (e) {
          var hero = document.querySelector('[data-hero-cover]');
          var restore = function () {
            document.querySelectorAll('.vt-cover').forEach(function (n) {
              if (n !== hero) n.classList.remove('vt-cover');
            });
            if (hero) hero.classList.add('vt-cover');
          };
          if (!e.viewTransition) return restore();
          if (hero) settle(hero);
          // a skipped transition (hidden tab, slow load) is fine: the page simply appears
          e.viewTransition.ready.catch(function () {});
          var from = null;
          try {
            from = sessionStorage.getItem('vt:from');
          } catch (err) {}
          var m = from && from.match(/^\/work\/([^/]+)\/?$/);
          if (m && !hero) {
            var cards = document.querySelectorAll('[data-cover="' + m[1] + '"]');
            for (var i = 0; i < cards.length; i++) {
              var r = cards[i].getBoundingClientRect();
              if (r.bottom > 0 && r.top < innerHeight && r.right > 0 && r.left < innerWidth) {
                cards[i].classList.add('vt-cover');
                settle(cards[i]);
                break;
              }
            }
          }
          e.viewTransition.finished.then(restore, restore);
        });
      })();
    </script>
    <noscript><style>[data-split],[data-reveal]{visibility:visible!important}</style></noscript>
  </head>
  <body id="top">
    <div class="loader" aria-hidden="true">
      <div class="loader__clip"><div class="loader__mark"><Logo /></div></div>
      <div class="loader__foot">
        <div class="loader__row mono">
          <span>{site.name} — Portfolio</span>
          <span data-loader-count>000</span>
        </div>
        <div class="loader__bar"><i data-loader-bar></i></div>
      </div>
    </div>
    <a class="skip" href="#main">Skip to content</a>
    <div class="ambient" aria-hidden="true"></div>
    <Header />
    <Menu />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <div class="cursor" aria-hidden="true"><div class="cursor__ring"><div class="cursor__disc"><span class="cursor__label"></span></div></div><div class="cursor__dot"><i></i></div></div>
    <div id="page-end"></div>
    <script>
      import '../scripts/app.ts';
    </script>
  </body>
</html>
