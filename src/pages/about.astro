---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Services from '../components/Services.astro';
import ContactCta from '../components/ContactCta.astro';
import Arrow from '../components/Arrow.astro';
import Pill from '../components/Pill.astro';
import { site, about, stack, tintFor } from '../data/site';
import { getWork } from '../lib/work';

const [first, ...rest] = site.name.split(' ');
const work = await getWork();
// figures counted from the site's own content
const figures = [
  { value: work.length, label: 'Projects in the archive' },
  { value: new Set(work.flatMap((p) => p.data.tags)).size, label: 'Disciplines' },
  { value: stack.length, label: 'Tools in the daily stack' },
  { value: work.reduce((sum, p) => sum + 1 + p.data.gallery.length, 0), label: 'Images on this site' },
];
const cv = [
  { title: 'Experience', rows: about.experience, more: about.experienceMore },
  { title: 'Education', rows: about.education, more: '' },
];
---

<Base title="About" description={site.intro} image={about.portrait}>
  <PageHero eyebrow={site.role} lines={[first, rest.join(' ')]} tint={tintFor('/about/')}>
    {/* on wide screens the portrait sits at the end of the first name, as tall as the line */}
    <span slot="aside" class="mini">
      <span class="mini__photo frame" data-reveal="clip" data-delay="0.7" data-tilt data-accent="#19d3e0">
        <Image src={about.portrait} alt={`Portrait of ${site.name}`} widths={[320, 480, 720]} sizes="18rem" quality={80} loading="eager" />
      </span>
    </span>
  </PageHero>

  <section class="face wrap grid">
    <blockquote class="face__quote face__quote--a" data-split data-delay="0.6">“{about.quotes[0]}”</blockquote>
    {/* narrower or taller screens: the portrait sits here instead, at a modest size */}
    <div class="face__photo frame" data-reveal="clip" data-delay="0.35" data-tilt>
      <Image src={about.portrait} alt="" widths={[360, 560, 800]} sizes="(min-width: 640px) 22rem, 64vw" quality={80} loading="lazy" />
    </div>
    <blockquote class="face__quote face__quote--b" data-split>“{about.quotes[1]}”</blockquote>
  </section>

  <section class="bio wrap section grid">
    <p class="eyebrow mono bio__eyebrow" data-reveal style="--tint: var(--c-cyan)">
      <span class="eyebrow__rule"></span>
      <span>Hello</span>
    </p>
    <p class="bio__text" data-scrub-words>{site.intro}</p>
  </section>

  <section class="figs wrap" aria-label="In numbers">
    <ul class="figs__list">
      {
        figures.map((f) => (
          <li data-reveal>
            <span class="figs__num display" data-count={f.value}>
              {f.value}
            </span>
            <span class="mono dim">{f.label}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <Services>
    <div class="svc-more" data-reveal>
      <Pill href="/stack/" label="Tools I use" ghost />
    </div>
  </Services>

  {
    cv.map((block) => (
      <section class="cv wrap grid">
        <h2 class="cv__title display" data-split="chars">
          {block.title}
        </h2>
        <ul class="cv__rows">
          {block.rows.map((row) => (
            <li data-reveal>
              {row.href ? (
                <a class="cv__row" href={row.href} target="_blank" rel="noopener">
                  <span class="cv__name">{row.name}</span>
                  <span class="cv__role mono">{row.role}</span>
                  <span class="cv__when mono">{row.when}</span>
                  <Arrow class="cv__arrow" />
                </a>
              ) : (
                <div class="cv__row">
                  <span class="cv__name">{row.name}</span>
                  <span class="cv__role mono">{row.role}</span>
                  <span class="cv__when mono">{row.when}</span>
                  <span class="cv__arrow" />
                </div>
              )}
            </li>
          ))}
          {block.more && (
            <li class="cv__more" data-reveal>
              <Pill href={block.more} label="More on LinkedIn" ghost external />
            </li>
          )}
        </ul>
      </section>
    ))
  }

  <section class="kit wrap section grid">
    <h2 class="cv__title display" data-split="chars">Skills</h2>
    <dl class="kit__groups">
      {
        about.skills.map((g) => (
          <div class="kit__group" data-reveal>
            <dt class="mono">{g.group}</dt>
            <dd>
              {g.items.map((item) => (
                <span class="chip kit__chip">{item}</span>
              ))}
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="likes" aria-label="Interests">
    <p class="eyebrow mono wrap" data-reveal style="--tint: var(--c-pink)">
      <span class="eyebrow__rule"></span>
      <span>Interests</span>
    </p>
    <div class="likes__strip" data-marquee data-speed="1.1">
      <ul class="likes__track display" data-marquee-track>
        {about.interests.map((word, i) => <li class:list={[i % 2 === 1 && 'outline']}>{word}</li>)}
      </ul>
    </div>
  </section>

  <ContactCta />
</Base>

<script>
  // the portrait follows straight after the first name (whose size depends on the screen)
  const line = document.querySelector<HTMLElement>('.phero__line');
  const text = line?.querySelector<HTMLElement>('[data-fit-text]');
  const aside = line?.querySelector<HTMLElement>('.phero__aside');
  if (line && text && aside) {
    const place = () => {
      aside.style.left = `${text.offsetWidth + text.offsetHeight * 0.14}px`;
      aside.style.right = 'auto';
    };
    place();
    new ResizeObserver(place).observe(text);
  }
</script>

<style>
  /* ---------- portrait + quotes ---------- */
  /* the portrait next to the name: only where the first line leaves room for it */
  .mini {
    display: none;
    height: 100%;
    padding-block: 0.04em;
    rotate: 4deg;
  }
  .mini__photo {
    display: block;
    height: 100%;
    aspect-ratio: 4 / 5;
    box-shadow: 0 24px 60px rgb(0 0 0 / 0.45);
  }
  .mini__photo :global(img),
  .face__photo :global(img) {
    object-position: 50% 12%;
  }
  .face {
    row-gap: 2rem;
    padding-top: clamp(2rem, 5vw, 5rem);
  }
  .face__photo {
    grid-column: 5 / span 4;
    grid-row: 1 / span 2;
    justify-self: center;
    width: min(100%, 22rem);
    aspect-ratio: 4 / 5;
  }
  @media (min-width: 900px) and (min-aspect-ratio: 5 / 4) {
    .mini {
      display: block;
    }
    .face__photo {
      display: none;
    }
    .face .face__quote--a {
      grid-column: 1 / span 5;
    }
    .face .face__quote--b {
      grid-column: 8 / -1;
    }
  }
  .face__quote {
    font-size: clamp(1.15rem, 0.9rem + 1vw, 1.9rem);
    font-weight: 500;
    line-height: 1.14;
    letter-spacing: -0.022em;
    text-wrap: balance;
  }
  .face__quote--a {
    grid-column: 1 / span 4;
    grid-row: 1;
    align-self: start;
    padding-right: 1rem;
  }
  .face__quote--b {
    grid-column: 9 / -1;
    grid-row: 2;
    align-self: end;
    padding-left: 1rem;
    text-align: right;
  }

  /* ---------- numbers ---------- */
  .figs__list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--gap);
    border-top: 1px solid var(--line-2);
  }
  .figs__list li {
    display: grid;
    justify-items: center;
    gap: 0.6rem;
    padding-block: clamp(1.25rem, 2.5vw, 2.25rem);
    text-align: center;
  }
  .figs__num {
    font-size: clamp(3.2rem, 1rem + 8vw, 9rem);
    font-variant-numeric: tabular-nums;
  }
  @media (max-width: 760px) {
    .figs__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* ---------- bio ---------- */
  .bio {
    row-gap: 1.5rem;
    align-items: start;
  }
  .bio__eyebrow {
    grid-column: 1 / span 3;
    padding-top: 0.9em;
  }
  .bio__text {
    grid-column: 4 / -1;
    font-size: clamp(1.95rem, 0.8rem + 4.9vw, 5.6rem);
    font-weight: 600;
    line-height: 1.02;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }
  .svc-more {
    display: flex;
    justify-content: center;
  }

  /* ---------- experience / education ---------- */
  .cv {
    row-gap: clamp(1.5rem, 3vw, 3rem);
    align-items: start;
    padding-top: clamp(3.5rem, 8vw, 8rem);
  }
  .cv__title {
    --wdth: 78;
    grid-column: 1 / span 4;
    font-size: clamp(2.4rem, 1.2rem + 4.3vw, 5.4rem);
  }
  .cv__rows {
    grid-column: 5 / -1;
    border-top: 1px solid var(--line-2);
  }
  .cv__row {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr) auto 1.1rem;
    align-items: baseline;
    gap: clamp(0.75rem, 2vw, 2rem);
    padding-block: clamp(1rem, 1.7vw, 1.6rem);
    border-bottom: 1px solid var(--line);
    transition: padding-left 0.6s var(--ease-out);
  }
  .cv__row::before {
    content: '';
    position: absolute;
    inset: auto 0 -1px 0;
    height: 1px;
    background: var(--fg);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.7s var(--ease-out);
  }
  a.cv__row:hover,
  a.cv__row:focus-visible {
    padding-left: clamp(0.5rem, 1.2vw, 1.25rem);
  }
  a.cv__row:hover::before,
  a.cv__row:focus-visible::before {
    transform: scaleX(1);
  }
  .cv__name {
    font-size: clamp(1.2rem, 1rem + 0.9vw, 1.9rem);
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: -0.028em;
  }
  .cv__role,
  .cv__when {
    color: var(--fg-2);
  }
  .cv__when {
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .cv__row :global(.cv__arrow) {
    width: 0.9rem;
    height: 0.9rem;
    align-self: center;
    opacity: 0;
    transform: translate(-0.4rem, 0.4rem);
    transition:
      opacity 0.3s,
      transform 0.6s var(--ease-out);
  }
  a.cv__row:hover :global(.cv__arrow),
  a.cv__row:focus-visible :global(.cv__arrow) {
    opacity: 1;
    transform: none;
  }
  .cv__more {
    padding-top: 1.5rem;
  }

  /* ---------- skills ---------- */
  .kit {
    row-gap: clamp(1.5rem, 3vw, 3rem);
    align-items: start;
    padding-bottom: clamp(3rem, 6vw, 6rem);
  }
  .kit__groups {
    grid-column: 5 / -1;
    border-top: 1px solid var(--line-2);
  }
  .kit__group {
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
    padding-block: clamp(1rem, 1.7vw, 1.5rem);
    border-bottom: 1px solid var(--line);
  }
  .kit__group dt {
    color: var(--fg-3);
    padding-top: 0.75em;
  }
  .kit__group dd {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .kit__chip {
    padding: 0.75em 1.15em;
    transition:
      background-color 0.35s var(--ease-out),
      color 0.35s var(--ease-out),
      border-color 0.35s;
  }
  .kit__chip:hover {
    background: var(--fg);
    border-color: var(--fg);
    color: var(--ink);
  }

  /* ---------- interests ---------- */
  .likes {
    display: grid;
    gap: clamp(1.25rem, 2.5vw, 2.25rem);
    overflow: clip;
  }
  .likes__strip:not(.is-live) {
    overflow-x: auto;
  }
  .likes__track {
    display: flex;
    width: max-content;
    font-size: clamp(3rem, 1rem + 10vw, 11rem);
    line-height: 0.95;
    will-change: transform;
  }
  .likes__track li {
    display: flex;
    align-items: center;
    padding-right: 0.32em;
    white-space: nowrap;
  }
  .likes__track li::after {
    content: '';
    width: 0.22em;
    height: 0.22em;
    margin-left: 0.32em;
    border-radius: 50%;
    background: var(--fg-3);
  }

  @media (max-width: 900px) {
    .face__photo {
      grid-column: 1 / -1;
      grid-row: auto;
      width: min(64vw, 20rem);
    }
    .face__quote--a,
    .face__quote--b {
      grid-column: 1 / -1;
      grid-row: auto;
      padding: 0;
      text-align: left;
      max-width: 24ch;
    }
    .face__quote--b {
      justify-self: end;
      text-align: right;
    }
    .bio__eyebrow,
    .bio__text,
    .cv__title,
    .cv__rows,
    .kit__groups {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 640px) {
    .cv__row {
      grid-template-columns: minmax(0, 1fr) auto;
      row-gap: 0.4rem;
    }
    .cv__name {
      grid-column: 1 / -1;
    }
    .cv__row :global(.cv__arrow) {
      display: none;
    }
    .kit__group {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.6rem;
    }
    .kit__group dt {
      padding-top: 0;
    }
  }
</style>
