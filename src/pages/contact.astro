---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Arrow from '../components/Arrow.astro';
import { site, socials, contactForm } from '../data/site';

const netlify = contactForm.provider === 'netlify';
---

<Base title="Contact" description={site.contactIntro}>
  <PageHero eyebrow="Contact" lines={["Let's talk"]} max={30} />

  <section class="ct wrap grid">
    <div class="ct__side">
      <p class="ct__intro lead balance" data-split data-delay="0.5">{site.contactIntro}</p>
      <dl class="ct__facts" data-reveal data-delay="0.65">
        <div>
          <dt class="mono">Local time</dt>
          <dd class="ct__time">
            <span data-clock data-zone={site.timezone}>--:--:--</span>
            <span class="mono dim" data-clock-zone></span>
          </dd>
        </div>
        <div>
          <dt class="mono">Based in</dt>
          <dd>{site.location}</dd>
        </div>
        {
          site.available && (
            <div>
              <dt class="mono">Status</dt>
              <dd class="ct__status-row">
                <span class="pulse" aria-hidden="true" />
                Available for work
              </dd>
            </div>
          )
        }
        <div>
          <dt class="mono">Elsewhere</dt>
          <dd>
            <ul class="ct__socials">
              {
                socials.map((s) => (
                  <li>
                    <a class="ulink" href={s.href} target="_blank" rel="noopener">
                      {s.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </dd>
        </div>
      </dl>
    </div>

    <form
      class="ct__form"
      name="contact"
      method="POST"
      action="/contact/"
      data-form
      data-provider={contactForm.provider}
      data-endpoint={contactForm.endpoint || undefined}
      data-netlify={netlify ? 'true' : undefined}
      netlify-honeypot={netlify ? 'bot-field' : undefined}
      data-reveal
      data-delay="0.55"
    >
      <input type="hidden" name="form-name" value="contact" />
      <input type="hidden" name="_subject" value="New message from your portfolio" />
      <input type="hidden" name="_template" value="table" />
      <p class="mono dim">Inquiry form</p>
      <label class="field">
        <span class="field__label mono">01 — Name</span>
        <input class="field__input" type="text" name="name" autocomplete="name" required />
      </label>
      <label class="field">
        <span class="field__label mono">02 — Email</span>
        <input class="field__input" type="email" name="email" autocomplete="email" required />
      </label>
      <label class="field">
        <span class="field__label mono">03 — Message</span>
        <textarea class="field__input" name="message" rows="4" required></textarea>
      </label>
      <p class="ct__trap" aria-hidden="true">
        <label>Leave this empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
      </p>
      <div class="ct__send">
        <button class="pill" type="submit" data-magnetic="0.22">
          <span class="pill__label"><span>Send email</span><span aria-hidden="true">Send email</span></span>
          <Arrow class="pill__arrow" />
        </button>
        <p class="ct__note mono" role="status" aria-live="polite" data-status></p>
      </div>
    </form>
  </section>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-form]');
  if (form) {
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const say = (state: string, text: string) => {
      form.dataset.state = state;
      status.textContent = text;
    };
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = new FormData(form);
      if (data.get('bot-field')) return; // filled in by a bot
      data.delete('bot-field');
      data.delete('form-name');
      const { provider, endpoint } = form.dataset;
      if (provider === 'off' || (provider === 'endpoint' && !endpoint)) {
        say('error', 'This form is not connected to an inbox yet. Please reach me through one of the links on this page.');
        return;
      }
      button.disabled = true;
      say('sending', 'Sending…');
      // give up after 15 seconds instead of leaving the visitor on "Sending…"
      const abort = new AbortController();
      const timer = setTimeout(() => abort.abort(), 15000);
      try {
        const response =
          provider === 'endpoint'
            ? await fetch(endpoint!, { method: 'POST', body: data, headers: { Accept: 'application/json' }, signal: abort.signal })
            : await fetch('/', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: new URLSearchParams(data as unknown as Record<string, string>).toString(),
                signal: abort.signal,
              });
        if (!response.ok) throw new Error(String(response.status));
        if (provider === 'endpoint') {
          const reply = await response.json().catch(() => null);
          if (reply && String(reply.success) !== 'true') throw new Error(reply.message || 'not accepted');
        }
        form.reset();
        say('sent', 'Thanks! Your message is on its way. I will get back to you soon.');
      } catch {
        say('error', 'That did not go through. Please try again, or reach me through one of the links on this page.');
      } finally {
        clearTimeout(timer);
        button.disabled = false;
      }
    });
  }
</script>

<style>
  .ct {
    row-gap: clamp(2.5rem, 6vw, 5rem);
    align-items: start;
    padding-top: clamp(2.5rem, 6vw, 6rem);
  }
  .ct__side {
    grid-column: 1 / span 5;
    display: grid;
    gap: clamp(2rem, 4vw, 3.5rem);
  }
  .ct__intro {
    max-width: 20ch;
  }
  .ct__facts {
    border-top: 1px solid var(--line-2);
  }
  .ct__facts > div {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr);
    gap: 1rem;
    align-items: baseline;
    padding-block: 0.95rem;
    border-bottom: 1px solid var(--line);
  }
  .ct__facts dt {
    color: var(--fg-3);
  }
  .ct__facts dd {
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .ct__time {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    font-size: clamp(1.5rem, 1.1rem + 1.6vw, 2.6rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }
  .ct__status-row {
    display: flex;
    align-items: center;
    gap: 0.8em;
  }
  .ct__socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.25rem;
  }

  .ct__form {
    grid-column: 7 / -1;
    display: grid;
    gap: clamp(1.4rem, 2.4vw, 2.2rem);
    padding: clamp(1.25rem, 2.6vw, 2.75rem);
    border-radius: calc(var(--radius) * 1.3);
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .field {
    display: grid;
    gap: 0.55rem;
  }
  .field__label {
    color: var(--fg-3);
    transition: color 0.3s;
  }
  .field:focus-within .field__label {
    color: var(--fg);
  }
  .field__input {
    width: 100%;
    padding: 0.35em 0 0.5em;
    border: 0;
    border-bottom: 1px solid var(--line-2);
    border-radius: 0;
    background: transparent;
    font-size: clamp(1.25rem, 1rem + 1.1vw, 2rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.2;
    outline: none;
    resize: vertical;
    transition: border-color 0.3s;
  }
  .field__input:focus-visible {
    border-bottom-color: var(--fg);
    box-shadow: 0 1px 0 0 var(--fg);
  }
  .field__input:-webkit-autofill {
    -webkit-text-fill-color: var(--fg);
    box-shadow: 0 0 0 100px var(--surface) inset;
    caret-color: var(--fg);
  }
  textarea.field__input {
    min-height: 5.5em;
  }
  .ct__trap {
    position: absolute;
    left: -200vw;
  }
  .ct__send {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    padding-top: 0.4rem;
  }
  .ct__send .pill:disabled {
    opacity: 0.6;
    cursor: progress;
  }
  .ct__note {
    flex: 1 1 16rem;
    color: var(--fg-2);
    text-transform: none;
    letter-spacing: 0;
    font-size: 0.8rem;
    line-height: 1.5;
  }
  .ct__form[data-state='sent'] .ct__note {
    color: var(--fg);
  }

  @media (max-width: 900px) {
    .ct__side,
    .ct__form {
      grid-column: 1 / -1;
    }
  }
</style>
