// Earlier versions are kept, unlinked and hidden from search engines:
//   /testv2        this page plus a line running through every section (src/pages/testv2.astro)
//   /backup-strip  the previous home page: moving strip under the hero, cards in a sideways row
//   /backup        the portrait with the hover lens instead of the cards (src/pages/backup.astro)
//   /classic       the contour map and image trail (src/pages/classic.astro)
import Home from '../components/Home.astro';
---

<Home emerge ring />
