---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Arrow from '../components/Arrow.astro';
import ContactCta from '../components/ContactCta.astro';
import { stack, tintFor } from '../data/site';

const pad = (n: number) => String(n).padStart(2, '0');
---

<Base title="Stack" description="The tools Alex Menzies uses every day — from Illustrator and Photoshop to After Effects and Notion.">
  <PageHero eyebrow="Tools I use everyday" lines={['Tech', 'Stack']} count={stack.length} tint={tintFor('/stack/')} />

  <section class="st wrap" aria-label="Tools">
    <ul class="st__grid">
      {
        stack.map((tool, i) => {
          const Tag = tool.href ? 'a' : 'div';
          const linkProps = tool.href ? { href: tool.href, target: '_blank', rel: 'noopener' } : {};
          return (
            <li data-reveal data-delay={(i % 4) * 0.06}>
              <Tag class="st__tile" data-tilt {...linkProps}>
                <span class="st__top mono">
                  <span>{pad(i + 1)}</span>
                  <span>{tool.label}</span>
                </span>
                <span class="st__symbol display" aria-hidden="true">
                  {tool.symbol}
                </span>
                <span class="st__name">
                  {tool.name}
                  {tool.href && <Arrow class="st__arrow" />}
                </span>
              </Tag>
            </li>
          );
        })
      }
      <li class="st__wide" data-reveal>
        <a class="st__tile st__tile--cta" href="/work/">
          <span class="st__top mono">
            <span>→</span>
            <span>See them at work</span>
          </span>
          <span class="st__cta display">View the work</span>
        </a>
      </li>
    </ul>
  </section>

  <ContactCta />
</Base>

<style>
  .st {
    padding-top: clamp(2.5rem, 6vw, 6rem);
  }
  /* a periodic table of tools */
  .st__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--gap);
  }
  .st__wide {
    grid-column: span 3;
  }
  .st__tile {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr auto;
    gap: 1rem;
    height: 100%;
    min-height: clamp(13rem, 21vw, 22rem);
    padding: clamp(0.9rem, 1.4vw, 1.4rem);
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line);
    overflow: clip;
    transition:
      background-color 0.5s var(--ease-out),
      color 0.5s var(--ease-out);
  }
  .st__top {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--fg-2);
    transition: color 0.5s var(--ease-out);
  }
  .st__symbol {
    align-self: center;
    font-size: clamp(4rem, 2rem + 8vw, 10.5rem);
    line-height: 0.8;
    text-transform: none;
    letter-spacing: -0.05em;
    transition: font-stretch 0.8s var(--ease-out);
  }
  .st__name {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: clamp(1.1rem, 0.95rem + 0.6vw, 1.5rem);
    font-weight: 600;
    letter-spacing: -0.025em;
  }
  .st__tile :global(.st__arrow) {
    width: 0.7em;
    height: 0.7em;
  }
  .st__tile:hover,
  a.st__tile:focus-visible {
    background: var(--fg);
    color: var(--ink);
  }
  .st__tile:hover .st__top,
  a.st__tile:focus-visible .st__top {
    color: var(--ink);
  }
  .st__tile:hover .st__symbol,
  a.st__tile:focus-visible .st__symbol {
    --wdth: 125;
  }
  .st__tile--cta {
    background: transparent;
  }
  .st__cta {
    align-self: end;
    grid-row: 2 / span 2;
    font-size: clamp(2.4rem, 1rem + 6vw, 7.5rem);
    line-height: 0.86;
    transition: font-stretch 0.8s var(--ease-out);
  }
  .st__tile--cta:hover .st__cta {
    --wdth: 112;
  }
  @media (max-width: 1000px) {
    .st__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .st__wide {
      grid-column: span 2;
    }
  }
  @media (max-width: 640px) {
    .st__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .st__wide {
      grid-column: span 1;
    }
    .st__cta {
      font-size: clamp(1.6rem, 9vw, 2.6rem);
    }
  }
</style>
