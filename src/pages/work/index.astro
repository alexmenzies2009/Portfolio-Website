---
import { getWork } from '../../lib/work';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import ContactCta from '../../components/ContactCta.astro';
import { site, tintFor } from '../../data/site';
import { tintOf } from '../../lib/palette';

const work = await getWork();
// Filter buttons, in this order. A project shows under a filter when its "tags" include it.
const FILTERS = ['Branding', 'Design', 'Print', 'UI/UX', 'Animation', 'AI'];
const count = (tag: string) => work.filter((p) => p.data.tags.includes(tag)).length;
---

<Base title="Work" description={site.allWorkIntro}>
  <PageHero eyebrow="Work" lines={['All', 'Projects']} count={work.length} tint={tintFor('/work/')} />

  <section class="wk wrap">
    <div class="wk__bar">
      <p class="wk__intro pretty" data-split data-delay="0.5">{site.allWorkIntro}</p>
      <div class="wk__tools" data-reveal data-delay="0.6">
        <div class="wk__filters" role="group" aria-label="Filter projects">
          <button class="bracket" type="button" data-filter="all" aria-pressed="true">All<sup>{work.length}</sup></button>
          {
            FILTERS.map((f) => (
              <button class="bracket" type="button" data-filter={f} aria-pressed="false" style={`--accent-text: ${tintOf(f)}`}>
                {f}
                <sup>{count(f)}</sup>
              </button>
            ))
          }
        </div>
        <div class="wk__views" role="group" aria-label="Layout">
          <button class="bracket" type="button" data-view="grid" aria-pressed="true">Grid</button>
          <button class="bracket" type="button" data-view="list" aria-pressed="false">List</button>
        </div>
      </div>
    </div>

    <ul class="wk__list" data-list data-view="grid">
      {
        work.map((p, i) => (
          <li class="wk__item" data-item data-tags={p.data.tags.join('|')}>
            <ProjectCard entry={p} eager={i < 3} />
          </li>
        ))
      }
    </ul>
    <div class="wk__peek" data-peek aria-hidden="true">
      <div class="wk__peek-tilt" data-peek-tilt>
        <div class="wk__peek-card frame"><img alt="" /><img alt="" /></div>
      </div>
    </div>
  </section>

  <ContactCta />
</Base>

<script>
  import { gsap, ScrollTrigger, reduced, finePointer, finishReveals } from '../../scripts/motion';

  const list = document.querySelector<HTMLElement>('[data-list]');
  if (list) {
    const items = [...list.querySelectorAll<HTMLElement>('[data-item]')];
    const filterBtns = [...document.querySelectorAll<HTMLButtonElement>('[data-filter]')];
    const viewBtns = [...document.querySelectorAll<HTMLButtonElement>('[data-view]')].filter((b) => b.tagName === 'BUTTON');
    const shown = () => items.filter((i) => !i.hidden);

    // Changing what the list shows: the current cards fade out, the list eases to its new height,
    // and the new set rises in one after another (their image reveals finished, so nothing pops).
    let run = 0;
    const swap = async (change: () => void) => {
      if (reduced) {
        change();
        finishReveals(list);
        ScrollTrigger.refresh();
        return;
      }
      const mine = ++run;
      const before = shown();
      gsap.killTweensOf([list, ...items]);
      await gsap.to(before, { opacity: 0, y: 12, duration: 0.26, ease: 'power2.in', stagger: Math.min(0.018, 0.16 / before.length) }).then();
      if (mine !== run) return;
      const from = list.offsetHeight;
      change();
      finishReveals(list);
      const to = list.offsetHeight;
      const after = shown();
      gsap.set(items, { clearProps: 'opacity,transform' });
      gsap.fromTo(list, { height: from }, { height: to, duration: 0.6, ease: 'expo.inOut', clearProps: 'height', onComplete: () => ScrollTrigger.refresh() });
      gsap.fromTo(after, { opacity: 0, y: 34 }, { opacity: 1, y: 0, duration: 0.8, ease: 'expo.out', delay: 0.08, stagger: Math.min(0.06, 0.7 / after.length), clearProps: 'opacity,transform' });
    };

    const setFilter = (filter: string) => {
      items.forEach((item) => {
        item.hidden = !(filter === 'all' || (item.dataset.tags || '').split('|').includes(filter));
      });
    };
    const applyFilter = (filter: string, animate: boolean) => {
      filterBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === filter)));
      if (animate) swap(() => setFilter(filter));
      else {
        setFilter(filter);
        ScrollTrigger.refresh();
      }
      const url = new URL(location.href);
      if (filter === 'all') url.searchParams.delete('filter');
      else url.searchParams.set('filter', filter);
      history.replaceState(null, '', url);
    };

    const applyView = (view: string) => {
      if (list.dataset.view === view) return;
      viewBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.view === view)));
      try {
        sessionStorage.setItem('work:view', view);
      } catch {}
      swap(() => (list.dataset.view = view));
    };

    filterBtns.forEach((b) => b.addEventListener('click', () => applyFilter(b.dataset.filter || 'all', true)));
    viewBtns.forEach((b) => b.addEventListener('click', () => applyView(b.dataset.view || 'grid')));

    // restore state from the address bar / last visit
    const wanted = new URL(location.href).searchParams.get('filter');
    if (wanted && filterBtns.some((b) => b.dataset.filter === wanted)) applyFilter(wanted, false);
    try {
      if (sessionStorage.getItem('work:view') === 'list') {
        list.dataset.view = 'list';
        viewBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.view === 'list')));
      }
    } catch {}

    // List view: the hovered project's cover sits right beside the pointer, tilted, and leans with
    // the pointer's movement. Moving to another row swaps the picture with a short zoom-and-fade.
    const peek = document.querySelector<HTMLElement>('[data-peek]');
    const tilt = peek?.querySelector<HTMLElement>('[data-peek-tilt]');
    const layers = [...(peek?.querySelectorAll<HTMLImageElement>('img') ?? [])];
    if (peek && tilt && layers.length === 2 && finePointer) {
      const xTo = gsap.quickTo(peek, 'x', { duration: reduced ? 0 : 0.32, ease: 'power3' });
      const yTo = gsap.quickTo(peek, 'y', { duration: reduced ? 0 : 0.32, ease: 'power3' });
      const lean = gsap.quickTo(tilt, 'rotation', { duration: 0.7, ease: 'power3' });
      let front = 0;
      let current = '';
      let last = { x: 0, y: 0 };
      let left = false;
      const base = () => (left ? -7 : 7);
      const settle = gsap.delayedCall(0.12, () => lean(base())).pause();
      gsap.set(tilt, { rotation: 7 });
      list.addEventListener('pointermove', (e) => {
        xTo(e.clientX);
        yTo(e.clientY);
        const card = peek.querySelector<HTMLElement>('.wk__peek-card');
        const flip = e.clientX > innerWidth - (card?.offsetWidth ?? 280) - 110;
        if (flip !== left) {
          left = flip;
          peek.classList.toggle('is-left', left);
        }
        if (!reduced) lean(gsap.utils.clamp(-16, 16, base() + (e.clientX - last.x) * 0.5));
        last = { x: e.clientX, y: e.clientY };
        settle.restart(true);
      });
      const show = (src: string, down: boolean) => {
        if (!src || src === current) return;
        current = src;
        const next = layers[1 - front];
        const prev = layers[front];
        front = 1 - front;
        next.src = src;
        next.style.zIndex = '2';
        prev.style.zIndex = '1';
        if (reduced || !peek.classList.contains('is-on')) {
          gsap.set(next, { opacity: 1, scale: 1, yPercent: 0 });
          gsap.set(prev, { opacity: 0 });
          return;
        }
        gsap.fromTo(next, { opacity: 0, scale: 1.18, yPercent: down ? 6 : -6 }, { opacity: 1, scale: 1, yPercent: 0, duration: 0.55, ease: 'expo.out' });
        gsap.to(prev, { opacity: 0, scale: 0.94, duration: 0.45, ease: 'power2.out' });
        lean(base() + (down ? 5 : -5));
      };
      let lastIndex = -1;
      items.forEach((item, index) => {
        item.addEventListener('pointerenter', (e) => {
          if (list.dataset.view !== 'list') return;
          const img = item.querySelector<HTMLImageElement>('img');
          if (!peek.classList.contains('is-on')) {
            gsap.set(peek, { x: e.clientX, y: e.clientY });
            last = { x: e.clientX, y: e.clientY };
          }
          show(img ? img.currentSrc || img.src : '', index > lastIndex);
          lastIndex = index;
          peek.classList.add('is-on');
        });
      });
      list.addEventListener('pointerleave', () => {
        peek.classList.remove('is-on');
        lastIndex = -1;
      });
    }
  }
</script>

<style>
  .wk {
    display: grid;
    gap: clamp(2rem, 4vw, 4rem);
    padding-top: clamp(2rem, 4vw, 4rem);
  }
  .wk__bar {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(1.5rem, 3vw, 2.75rem);
  }
  .wk__intro {
    max-width: 38ch;
    font-size: var(--fs-lead);
    font-weight: 500;
    line-height: 1.16;
    letter-spacing: -0.022em;
  }
  .wk__tools {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 1rem 2rem;
    padding-block: 1.1rem;
    border-block: 1px solid var(--line);
  }
  .wk__filters,
  .wk__views {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem clamp(0.9rem, 1.8vw, 1.9rem);
  }
  .wk__tools :global(.bracket) {
    color: var(--fg-2);
    padding-block: 0.35rem;
    transition: color 0.3s;
  }
  .wk__tools :global(.bracket:hover),
  .wk__tools :global(.bracket[aria-pressed='true']) {
    color: var(--fg);
  }
  .wk__tools :global(.bracket:not([aria-pressed='true']):not(:hover))::before,
  .wk__tools :global(.bracket:not([aria-pressed='true']):not(:hover))::after {
    opacity: 0;
  }
  .wk__tools sup {
    margin-left: -0.25em;
    font-size: 0.82em;
    color: var(--fg-3);
    vertical-align: 0.5em;
    line-height: 0;
  }

  /* ----- grid view ----- */
  .wk__list[data-view='grid'] {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(2rem, 3.6vw, 4rem) var(--gap);
  }
  /* a gentle stagger so the grid does not read as a spreadsheet */
  .wk__list[data-view='grid'] .wk__item:nth-child(3n + 2 of :not([hidden])) {
    margin-top: clamp(0rem, 3.5vw, 4rem);
  }

  /* ----- list view: same cards, shown as rows ----- */
  .wk__list[data-view='list'] {
    display: grid;
    border-top: 1px solid var(--line);
  }
  .wk__list[data-view='list'] .wk__item {
    border-bottom: 1px solid var(--line);
  }
  .wk__list[data-view='list'] :global(.card) {
    display: block;
    padding-block: clamp(0.9rem, 1.6vw, 1.5rem);
    transition: padding-left 0.6s var(--ease-out);
  }
  .wk__list[data-view='list'] :global(.card:hover) {
    padding-left: clamp(0.5rem, 1.4vw, 1.5rem);
  }
  .wk__list[data-view='list'] :global(.card__frame) {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  .wk__list[data-view='list'] :global(.card__meta) {
    grid-template-columns: 3.5ch minmax(0, 1fr) minmax(0, 14rem) minmax(0, 15rem);
    gap: clamp(0.9rem, 2vw, 2.25rem);
  }
  .wk__list[data-view='list'] :global(.card__cat) {
    display: block;
  }
  .wk__list[data-view='list'] :global(.card__tools) {
    text-align: right;
  }
  @media (max-width: 900px) {
    .wk__list[data-view='list'] :global(.card__meta) {
      grid-template-columns: 3.5ch minmax(0, 1fr) auto;
    }
    .wk__list[data-view='list'] :global(.card__tools) {
      display: none;
    }
  }
  @media (max-width: 560px) {
    .wk__list[data-view='list'] :global(.card__meta) {
      grid-template-columns: 3.5ch minmax(0, 1fr);
    }
    .wk__list[data-view='list'] :global(.card__cat) {
      display: none;
    }
  }
  .wk__list[data-view='list'] :global(.card__title) {
    font-size: clamp(1.6rem, 1rem + 2.8vw, 3.75rem);
    font-weight: 650;
    letter-spacing: -0.04em;
    line-height: 1.02;
  }

  /* list view: the hovered project's cover, beside the pointer (the script moves .wk__peek to the
     pointer and leans .wk__peek-tilt; the card sits just clear of the cursor's label disc) */
  .wk__peek {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 70;
    width: 0;
    height: 0;
    pointer-events: none;
  }
  .wk__peek-tilt {
    position: absolute;
    top: 0;
    left: 0;
  }
  .wk__peek-card {
    position: absolute;
    top: 0;
    left: 3.4rem;
    width: clamp(12rem, 17vw, 18rem);
    aspect-ratio: 4 / 5;
    translate: 0 -50%;
    box-shadow: 0 30px 70px rgb(0 0 0 / 0.5);
    opacity: 0;
    scale: 0.82;
    transform-origin: 0% 50%;
    transition:
      opacity 0.3s,
      scale 0.55s var(--ease-out);
  }
  .wk__peek.is-left .wk__peek-card {
    left: auto;
    right: 3.4rem;
    transform-origin: 100% 50%;
  }
  .wk__peek.is-on .wk__peek-card {
    opacity: 1;
    scale: 1;
  }
  .wk__peek-card img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
  }

  @media (max-width: 1100px) {
    .wk__list[data-view='grid'] {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .wk__list[data-view='grid'] .wk__item:nth-child(3n + 2 of :not([hidden])) {
      margin-top: 0;
    }
    .wk__list[data-view='grid'] .wk__item:nth-child(2n of :not([hidden])) {
      margin-top: clamp(0rem, 5vw, 3.5rem);
    }
  }
  @media (max-width: 640px) {
    .wk__list[data-view='grid'] {
      grid-template-columns: minmax(0, 1fr);
    }
    .wk__list[data-view='grid'] .wk__item:nth-child(2n of :not([hidden])) {
      margin-top: 0;
    }
  }
</style>
